# MySQL 备份配置文件示例
# 将此文件复制为 config.conf 并根据实际情况修改

# 数据库连接配置
MYSQL_USER="root"
MYSQL_PASSWORD="your_password_here"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"

# 备份配置
BACKUP_ROOT="/var/backups/mysql"
INCREMENTAL_RETENTION=7
FULL_RETENTION=30

# 日志配置
LOG_FILE="/var/log/mysql_backup.log"

# mysqldump 额外参数（可选）
# MYSQLDUMP_ARGS="--single-transaction --master-data=2 --flush-logs"

# 二进制日志配置（增量备份需要）
# log_bin = /var/log/mysql/mysql-bin.log
# binlog_format = ROW